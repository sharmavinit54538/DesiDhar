# --- Frontend (exposed to the browser) ---
# Same-origin API path. Vite proxies /api to the API server in development;
# production is served by server/index.mjs from the same origin.
VITE_API_BASE_URL=/api

# --- API server (server-side only) ---
PORT=8787
HOST=0.0.0.0
# DATABASE
DB_PATH=./server/data/desidhar.db
# Set to 'false' to run the API without serving the built SPA
SERVE_STATIC=true
# AUTH — set a long random value in production
OTP_SECRET=
# Echo OTPs in API responses (development only; never in production)
OTP_DEV_ECHO=true
# SMS delivery: console (dev) | msg91 | unconfigured
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=DESIDH
# Comma-separated staff mobile numbers that are promoted to admin on sign-in
ADMIN_PHONES=
# PAYMENTS — online methods stay disabled until both keys are present
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
